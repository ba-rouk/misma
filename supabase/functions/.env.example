# Local Supabase Edge Function environment template.
# Supabase local Edge Functions read actual values from supabase/functions/.env.
# Production values belong in Supabase Edge Function Secrets.
# Keep the real .env file out of Git. Never commit or share real values.

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Netlify OAuth application (register https://misma.onrender.com/integrations/netlify/callback as its redirect URI).
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=

# Shared encrypted credential vault (used when storing customer platform tokens).
PLATFORM_CREDENTIAL_ACTIVE_KEY_VERSION=
PLATFORM_CREDENTIAL_ENCRYPTION_KEY_V1=
