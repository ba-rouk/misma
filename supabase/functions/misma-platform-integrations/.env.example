# Local Edge Function development only.
# Production values belong in Supabase Dashboard → Project Settings → Edge Functions → Secrets.
# Never copy these into the browser .env file, commit real values, or share them in chat.

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Shared encrypted credential vault (needed for platform credential save operations).
# The active version defaults to 1 in code when this is omitted.
PLATFORM_CREDENTIAL_ACTIVE_KEY_VERSION=
PLATFORM_CREDENTIAL_ENCRYPTION_KEY_V1=
